{
  "context": {
    "soft_pct": 40,
    "soft_max_tokens": 500000,
    "hard_pct": 80,
    "windows": {
      "claude-opus-5-5": 1000000
    },
    "unknown_window": 200000
  },
  "limits": {
    "five_hour": {
      "no_new_mass": 60,
      "stop": 80
    },
    "five_hour_night": {
      "stop_before_morning": 95,
      "morning_window": {
        "no_new_mass": 70,
        "stop": 80
      }
    },
    "sensor_dir": "~/.cache/prorab/usage",
    "sensor_max_age_s": 300,
    "sensor_retention_s": 86400,
    "week_unknown_blind_s": 1800,
    "message_patterns": [
      "usage limit reached",
      "limit will reset",
      "approaching usage limit",
      "you've used",
      "you've hit your limit",
      "/rate-limit-options",
      "stop and wait for limit to reset",
      "api error: rate limit reached"
    ],
    "limit_screen": [
      "usage limit reached",
      "you've hit your limit",
      "you've hit your session limit",
      "/rate-limit-options"
    ],
    "limit_choice": {
      "wait": "stop and wait",
      "upgrade": "upgrade"
    },
    "fatal_patterns": [
      "model_not_found",
      "insufficient_quota",
      "quota_exceeded"
    ]
  },
  "week": {
    "alert_pct": 95,
    "clearance_pct": 100,
    "margin_pp": 20,
    "fallback_notify_pct": 50,
    "fallback_clearance_pct": 70,
    "burn_horizon_working_h": 10,
    "calendar": {
      "days": ["mon", "tue", "wed", "thu", "fri"],
      "start": "09:00",
      "end": "19:00"
    }
  },
  "timeouts": {
    "bd_s": 30,
    "git_s": 60,
    "herdr_s": 60
  },
  "send": {
    "timeout_ms": 60000,
    "files_dir": "~/.cache/prorab/work-orders",
    "composer_match_chars": 20
  },
  "screen": {
    "tail_lines": 15,
    "resume_failed": "no conversation found with session id",
    "worktree_exit": {
      "marker": "exiting worktree session",
      "keep": "1. keep worktree"
    },
    "exit_bg_work": "background work is running",
    "login": [["not logged in", "please run /login"], ["select login method"]]
  },
  "cycles": {
    "approval": 6,
    "review": 10,
    "report_fix": 3
  },
  "handover": {
    "min_interval_s": 600
  },
  "crew": {
    "ask_timeout_s": 600,
    "trust_path": "~/.claude.json",
    "projects_dir": "~/projects",
    "trust_retry_s": 1,
    "exit_window_s": 300
  },
  "budget": {
    "usd": 100,
    "week_pp": 10
  },
  "machine": {
    "parallel_ceiling": 6,
    "heavy_slots": 2,
    "heavy_runs_per_stage": 60
  },
  "cost": {
    "prices": {
      "opus": {"input": 4.0, "output": 20.0, "cache_read": 0.2},
      "sonnet": {"input": 2.0, "output": 10.0, "cache_read": 0.2},
      "haiku": {"input": 0.1, "output": 0.5, "cache_read": 0.01},
      "fable": {"input": 10.0, "output": 50.0, "cache_read": 0.25}
    },
    "cache_write_5m_factor": 1.25,
    "cache_write_1h_factor": 2.0
  },
  "rate": {
    "default_window_usd_per_pp": 3.5,
    "default_week_usd_per_pp": 10.0,
    "min_rise_pp": 1,
    "window_horizon_s": 18000,
    "every_s": 600
  },
  "night": {
    "morning": "08:00"
  },
  "schedule": {
    "default_duration_min": 30,
    "burn_min_span_s": 600
  },
  "hooks": {
    "deny": [
      "git push", "gh pr create", "gh pr merge", "gh release", "bd init", "sudo ",
      "brew install", "git reset --hard", "git clean -f", "git checkout main",
      "git checkout master", "git switch main", "git switch master",
      "claude auth", "claude login", "claude logout", "claude setup-token", "claude /login"
    ],
    "events_dir": "~/.cache/prorab/events",
    "events_retention_s": 86400,
    "settings_path": "~/.cache/prorab/crew-settings.json",
    "suggestions_setting": {"promptSuggestionEnabled": false}
  },
  "emergency": {
    "stop_path": "~/.cache/prorab/STOP"
  },
  "monitor": {
    "interval_s": 90,
    "heartbeat_s": 1200,
    "hung_s": 1800,
    "max_restarts": 2,
    "error_polls": 3,
    "interval_max_s": 300,
    "backoff_factor": 2,
    "hung_scan_max_files": 20000,
    "limit_panes": 2,
    "spend_every_s": 300,
    "reset_grace_s": 120,
    "awake_hold_s": 1200,
    "awake_min_left_s": 600,
    "sleep_gap_s": 120,
    "sleep_merge_s": 600
  }
}
