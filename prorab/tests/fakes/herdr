#!/usr/bin/env python3
"""Fake herdr CLI for tests. Routes live in $FAKE_HERDR_DIR/routes.json:
{"<argv prefix>": "<file>" | {"file": f, "exit": n, "sleep": s, "stderr": f2} | {"seq": [f, ...], "exit": n}}
(sleep: seconds to wait before answering; stderr: a file written to stderr whatever the exit code).
Longest matching prefix wins; every call is appended to calls.log. The response
file goes to stdout on exit 0 and to stderr otherwise."""
import json
import os
import sys
import time

d = os.environ["FAKE_HERDR_DIR"]
line = " ".join(sys.argv[1:])
with open(os.path.join(d, "calls.log"), "a", encoding="utf-8") as fh:
    fh.write(line + "\n")
with open(os.path.join(d, "routes.json"), encoding="utf-8") as fh:
    routes = json.load(fh)
keys = [k for k in routes if line == k or line.startswith(k + " ")]
if not keys:
    sys.stderr.write(json.dumps({"error": {"code": "fake_no_route", "message": line}}))
    sys.exit(99)
key = max(keys, key=len)
route = routes[key]
code = 0
if isinstance(route, dict):
    code = route.get("exit", 0)
    if route.get("stderr"):
        with open(os.path.join(d, route["stderr"]), encoding="utf-8") as fh:
            sys.stderr.write(fh.read())
    if route.get("sleep"):
        time.sleep(route["sleep"])
    if "seq" in route:
        cp = os.path.join(d, "counter-" + "".join(c if c.isalnum() else "_" for c in key))
        n = 0
        if os.path.exists(cp):
            with open(cp) as fh:
                n = int(fh.read() or 0)
        with open(cp, "w") as fh:
            fh.write(str(n + 1))
        fname = route["seq"][min(n, len(route["seq"]) - 1)]
    else:
        fname = route["file"]
else:
    fname = route
with open(os.path.join(d, fname), encoding="utf-8") as fh:
    body = fh.read()
(sys.stdout if code == 0 else sys.stderr).write(body)
sys.exit(code)
